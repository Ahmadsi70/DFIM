# DFIM Management API — Multi-stage Docker build (ghcr.io)
# Build: docker build -f deploy/Dockerfile.api -t dfim-api .
#
# dfim_management_api has no workspace path-deps, so we replace the root
# Cargo.toml with a minimal single-member workspace during the build.

FROM rust:1.91-slim-bookworm AS builder

WORKDIR /build
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

COPY Cargo.lock ./
COPY dfim_management_api/ ./dfim_management_api/

# Minimal workspace Cargo.toml — single member, no path-deps.
RUN printf '%s\n' \
  '[workspace]' \
  'resolver = "2"' \
  'members = ["dfim_management_api"]' \
  '' \
  '[workspace.package]' \
  'version = "0.1.0"' \
  'edition = "2021"' \
  'license = "Apache-2.0"' \
  'authors = ["DFIM Engineering"]' \
  > Cargo.toml

ARG DFIM_CRYPTO_KEY
ENV DFIM_CRYPTO_KEY=${DFIM_CRYPTO_KEY}
RUN cargo build -p dfim_management_api --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/dfim_management_api /usr/local/bin/dfim-management-api
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --retries=3 CMD curl -f http://localhost:3000/health || exit 1
ENTRYPOINT ["/usr/local/bin/dfim-management-api"]