# DFIM Deployment — Environment Variables
# Copy this file to .env and fill in your values
#   cp deploy/.env.example deploy/.env

# PostgreSQL (required)
POSTGRES_PASSWORD=change_me_32_chars_minimum

# Management API (required)
DFIM_JWT_SECRET=change_me_at_least_32_bytes_long
DFIM_ADMIN_USER=admin
DFIM_ADMIN_PASSWORD=change_me_secure_password

# Grafana (required)
GF_SECURITY_ADMIN_PASSWORD=change_me_grafana_password